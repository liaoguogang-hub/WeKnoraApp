# ---- 依赖与构建产物 ----
node_modules/
dist/
*.log

# ---- Android 构建产物 ----
# （android/.gitignore 里已有 Android 官方模板，这里做双保险）
android/.gradle/
android/build/
android/app/build/
android/app/release/
android/local.properties
android/**/build/
*.apk
*.aab
*.ap_
*.dex

# ---- 签名与密钥：绝不入库 ----
*.jks
*.keystore
*.p12
google-services.json
android/app/google-services.json

# ---- IDE ----
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# ---- 端侧模型大文件（约 32MB，随 APK 打包但不进 git）----
# 由 npm run fetch-model 补齐（已接入 npm run build，幂等）
public/models/
public/ort/

# ---- 临时/调试产物 ----
*.bak
*.tmp
