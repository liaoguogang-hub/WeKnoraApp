{
  "name": "weknora-app",
  "version": "0.2.1",
  "description": "WeKnora Android client (Capacitor + Lit + TypeScript)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "android:run": "cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/share": "^6.0.4",
    "@xenova/transformers": "^2.17.2",
    "dexie": "^4.0.10",
    "lit": "^3.2.1",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@types/markdown-it": "^14.1.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
